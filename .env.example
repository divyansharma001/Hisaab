# Copy to .env and fill in. Never commit .env.

# The only real secret here.
# OpenRouter key (starts sk-or-v1-), or an OpenAI key if you point straight at OpenAI.
LLM_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Where to send the request.
#   OpenRouter    https://openrouter.ai/api/v1
#   OpenAI direct leave this blank
LLM_BASE_URL=https://openrouter.ai/api/v1

# Model name. OpenRouter prefixes with the provider; OpenAI direct does not.
#   OpenRouter    openai/gpt-4o-mini
#   OpenAI direct gpt-4o-mini
LLM_MODEL=openai/gpt-4o-mini

# Hard cap on LLM calls per batch. Hitting it sends the rest to review.
LLM_CALL_BUDGET=40

# Fixed so every run produces the same 130 records.
RANDOM_SEED=20260829

# Database
POSTGRES_USER=hisaab
POSTGRES_PASSWORD=hisaab
POSTGRES_DB=hisaab
POSTGRES_PORT=5432

# Ports on the host
API_PORT=8000
WEB_PORT=5173

# Where the browser reaches the API
VITE_API_URL=http://localhost:8000

LOG_LEVEL=info
