# Copy to .env and fill in. Never commit .env.

# The only real secret here.
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
ANTHROPIC_MODEL=claude-sonnet-5

# Hard cap on LLM calls per batch. Hitting it sends the rest to review.
LLM_CALL_BUDGET=40

# Fixed so every run produces the same 130 records.
RANDOM_SEED=20260829

# Database
POSTGRES_USER=hisaab
POSTGRES_PASSWORD=hisaab
POSTGRES_DB=hisaab
POSTGRES_PORT=5432

# Ports on the host
API_PORT=8000
WEB_PORT=5173

# Where the browser reaches the API
VITE_API_URL=http://localhost:8000

LOG_LEVEL=info
